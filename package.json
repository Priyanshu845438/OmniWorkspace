{
  "name": "omni-workspace",
  "version": "1.0.0",
  "description": "Open-Source, Model-Agnostic Universal AI Workspace for Coding, Research, Data, SQL, Media, Automation, and Documents",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "node dist-server/index.js",
    "prod": "npm run build && node dist-server/index.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "dev:electron": "concurrently -n \"SERVER,CLIENT,ELECTRON\" -c \"blue,magenta,green\" \"npm run dev:server\" \"vite client\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:server && npm run build:client && npm run build:electron",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build client",
    "build:electron": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:all": "npm run build && electron-builder -mwl",
    "dist:check": "electron-builder --help"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "ai",
    "workspace",
    "ide",
    "model-agnostic",
    "byok",
    "agents",
    "orchestrator",
    "open-source",
    "electron",
    "windows",
    "developer-tools"
  ],
  "author": "OmniWorkspace Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.omniworkspace.app",
    "productName": "OmniWorkspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-client/**/*",
      "dist-server/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniWorkspace"
    }
  }
}
